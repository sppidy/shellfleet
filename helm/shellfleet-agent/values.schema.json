{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "shellfleet-agent values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "The agent is a singleton because one credential set backs one WebSocket identity."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiUrl", "wsUrl"],
      "properties": {
        "apiUrl": { "type": "string", "pattern": "^https?://[^[:space:]]+$" },
        "wsUrl": { "type": "string", "pattern": "^wss?://[^[:space:]]+$" }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string" } }
    },
    "mtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string" } }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "retain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"
        },
        "retain": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "exec", "write"],
      "properties": {
        "read": { "type": "boolean" },
        "exec": { "type": "boolean" },
        "write": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "create": { "const": false } },
            "required": ["create"]
          },
          "then": { "properties": { "name": { "minLength": 1 } } }
        }
      ]
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "resources": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "imagePullSecrets": { "type": "array" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podLabels": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "required": ["replicaCount", "image", "server", "token", "mtls", "persistence", "rbac", "serviceAccount"]
}
